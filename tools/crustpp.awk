# crustpp.awk — proof-of-concept transpiler from Rust-ish syntax to C.
# Unlike the C preprocessor, awk/sed see ARBITRARY tokens, so we can
# genuinely rewrite `fn f(a: i32) -> i32` into `int32_t f(int32_t a)`.
# Handles (demo scope): fn signatures with `name: Type` params and `-> Type`
# returns, `let [mut] x: T = ...` / `let x = ...`, `println!("{}", ...)`,
# and a trailing expression before `}` becoming `return expr;`.
BEGIN {
    print "/* generated by crustpp.awk — do not edit */";
    print "#include <stdio.h>";
    print "#include <stdint.h>";
    t["i8"]="int8_t"; t["i16"]="int16_t"; t["i32"]="int32_t"; t["i64"]="int64_t";
    t["u8"]="uint8_t"; t["u16"]="uint16_t"; t["u32"]="uint32_t"; t["u64"]="uint64_t";
    t["usize"]="size_t"; t["isize"]="ptrdiff_t"; t["f32"]="float"; t["f64"]="double";
    t["bool"]="_Bool"; t["String"]="char*"; t["char"]="char";
    prev = "";
}
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function ctype(s) { s = trim(s); return (s in t) ? t[s] : s }
function cparams(p,   arr, m, i, out, kv) {
    p = trim(p);
    if (p == "") return "void";
    m = split(p, arr, ",");
    out = "";
    for (i = 1; i <= m; i++) {
        if (split(arr[i], kv, ":") == 2)
            out = out (i > 1 ? ", " : "") ctype(kv[2]) " " trim(kv[1]);
        else
            out = out (i > 1 ? ", " : "") trim(arr[i]);
    }
    return out;
}
# fn name(params) -> ret {     or     fn name(params) {
/^fn[ \t]/ {
    line = $0;
    sub(/^fn[ \t]+/, "", line);
    match(line, /[A-Za-z_][A-Za-z0-9_]*/); name = substr(line, RSTART, RLENGTH);
    line = substr(line, RSTART + RLENGTH);
    match(line, /\([^)]*\)/); params = substr(line, RSTART + 1, RLENGTH - 2);
    line = substr(line, RSTART + RLENGTH);
    ret = "int";
    if (match(line, /->[ \t]*[A-Za-z_][A-Za-z0-9_]*/)) {
        ret = substr(line, RSTART, RLENGTH);
        sub(/^->[ \t]*/, "", ret);
    }
    print ctype(ret) " " name "(" cparams(params) ") {";
    prev = ""; next;
}
# let [mut] x: T = ...;   /   let x = ...;
/^[ \t]*let[ \t]/ {
    line = $0;
    sub(/^[ \t]*let[ \t]+/, "", line);
    sub(/^mut[ \t]+/, "", line);
    if (match(line, /^[A-Za-z_][A-Za-z0-9_]*[ \t]*:[ \t]*[A-Za-z_][A-Za-z0-9_]*/)) {
        d = substr(line, RSTART, RLENGTH);
        split(d, kv, ":");
        v = trim(kv[1]); ty = ctype(kv[2]);
        { rest = substr(line, RSTART + RLENGTH); if (rest !~ /;[ \t]*$/) rest = rest ";"; print "    " ty " " v rest; }
    } else {
        match(line, /^[A-Za-z_][A-Za-z0-9_]*/);
        print "    __auto_type " substr(line, RSTART);
    }
    prev = ""; next;
}
# println!("{}", args);
/println!/ {
    line = $0;
    sub(/^[ \t]*println!\(/, "", line);
    sub(/\);[ \t]*$/, "", line);
    gsub(/\{\}/, "%d\\n", line);
    print "    printf(" line ");";
    prev = ""; next;
}
# default: buffer one line so a trailing expression before `}` becomes `return expr;`
{
    if (prev != "" && $0 ~ /^[ \t]*\}/ && prev !~ /;[ \t]*$/ && prev !~ /\{[ \t]*$/ && prev !~ /\}[ \t]*$/ && prev !~ /^[ \t]*$/)
        print "    return " prev ";";
    else if (prev != "")
        print prev;
    prev = $0;
}
END { if (prev != "") print prev }
